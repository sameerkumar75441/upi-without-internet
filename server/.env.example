PORT=8080
# Get this from MongoDB Atlas: Database > Connect > Drivers.
# Encode special password characters: @ becomes %40, # becomes %23, / becomes %2F.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/upi_mesh?retryWrites=true&w=majority
# Comma-separated frontend origins permitted to call the API and Socket.IO.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PACKET_MAX_AGE_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400
