# Use a MongoDB Atlas connection string. Atlas must support transactions (replica set).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/upi_mesh?retryWrites=true&w=majority
# Public backend origin and public frontend origin. No trailing slash.
CORS_ORIGIN=https://api.example.com
VITE_API_URL=https://api.example.com/api
PACKET_MAX_AGE_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400
